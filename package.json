{
  "name": "ovningsprojekt-butik",
  "version": "1.0.0",
  "private": true,
  "description": "Övningsprojekt för delkursen AI-assisterad systemutveckling: REST-API för kunder och beställningar, med en äldre prisberäkningsmodul.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "jest --runInBand",
    "test:legacy": "pytest -q",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:up": "docker compose up -d db",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
